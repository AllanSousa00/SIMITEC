{
  "name": "simitec-evento",
  "version": "1.0.0",
  "description": "Site de inscrições da SIMITEC com login, verificação de e-mail, MongoDB e emissão de credenciais.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate:local-to-mongo": "node scripts/migrate-local-store-to-mongodb.js",
    "smtp:check": "node scripts/check-smtp.js",
    "smtp:test": "node scripts/check-smtp.js --send",
    "email:verify": "node scripts/verify-email-previews.js",
    "email:verify-route": "node scripts/verify-email-preview-route.js",
    "test:system": "node scripts/verify-system-flows.js",
    "test:unit": "node --test tests/unit/checkin-operations.test.js tests/unit/idempotency.test.js tests/unit/capacity-reservations.test.js",
    "test": "npm run test:unit && npm run test:system"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "googleapis": "^173.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "validator": "^13.12.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
